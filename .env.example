# Optional configuration for OpenRepurpose ML pipeline & local API bridge
# Copy to .env for local execution (do not commit .env)

# Compute device for ESM-2 embedding extraction: auto | cuda | cpu
OPENREPURPOSE_DEVICE=auto

# Recommended by NCBI E-utilities guidelines for automated PubMed novelty queries
NCBI_EMAIL=your-email@example.com
# Optional NCBI API key (increases rate limit from 3 req/s to 10 req/s)
NCBI_API_KEY=

# Local FastAPI inference bridge (optional)
API_HOST=127.0.0.1
API_PORT=8000
API_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_RATE_LIMIT_PER_MIN=30

# Security hardening for Remote HTTP MCP & Key Management
# Required if exposing /api/mcp/keys behind a reverse proxy, tunnel, or non-loopback interface
OPENREPURPOSE_ADMIN_TOKEN=
# Optional static MCP API key override for headless/CI deployments
OPENREPURPOSE_MCP_API_KEY=
# Optional extra allowed Host headers for Streamable HTTP MCP DNS-rebinding protection (comma-separated)
MCP_ALLOWED_HOSTS=
MCP_RATE_LIMIT_PER_MIN=120
MCP_MAX_ACTIVE_KEYS=50
